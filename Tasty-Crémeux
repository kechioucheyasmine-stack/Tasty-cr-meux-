<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tasty & Crémeux</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #fff8f0;
      color: #30251f;
    }

    header {
      background: #6f2dbd;
      color: white;
      text-align: center;
      padding: 28px 15px;
    }

    header h1 {
      margin: 0;
      font-size: 32px;
    }

    header p {
      margin-bottom: 0;
    }

    main {
      max-width: 700px;
      margin: auto;
      padding: 20px;
    }

    .plat {
      background: white;
      border-radius: 15px;
      padding: 18px;
      margin-bottom: 15px;
      box-shadow: 0 3px 10px #00000012;
    }

    .plat h2 {
      margin-top: 0;
    }

    .prix {
      font-weight: bold;
      color: #6f2dbd;
      font-size: 20px;
    }

    button {
      background: #6f2dbd;
      color: white;
      border: none;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 16px;
      cursor: pointer;
    }

    button:hover {
      background: #54218e;
    }

    input, select, textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 12px;
      margin: 7px 0 15px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    .panier {
      background: #fff;
      border: 2px solid #6f2dbd;
      border-radius: 15px;
      padding: 18px;
      margin-top: 25px;
    }

    .total {
      font-size: 22px;
      font-weight: bold;
      margin: 15px 0;
    }

    .message {
      background: #d9f7df;
      color: #176b2c;
      padding: 15px;
      border-radius: 10px;
      margin-top: 15px;
      display: none;
    }
  </style>
</head>

<body>
  <header>
    <h1>Tasty & Crémeux</h1>
    <p>Plats faits maison à Vaulx-en-Velin et alentours</p>
  </header>

  <main>
    <h2>Notre menu</h2>

    <section class="plat">
      <h2>Tasty Crousty</h2>
      <p>Un plat croustillant et savoureux préparé avec soin.</p>
      <p class="prix">7,50 €</p>
      <button onclick="ajouter('Tasty Crousty', 7.5)">
        Ajouter au panier
      </button>
    </section>

    <section class="plat">
      <h2>Pâtes au saumon</h2>
      <p>De délicieuses pâtes crémeuses au saumon.</p>
      <p class="prix">10,00 €</p>
      <button onclick="ajouter('Pâtes au saumon', 10)">
        Ajouter au panier
      </button>
    </section>

    <section class="panier">
      <h2>Mon panier</h2>

      <div id="contenuPanier">
        <p>Votre panier est vide.</p>
      </div>

      <p class="total">
        Total : <span id="total">0,00 €</span>
      </p>

      <h2>Passer commande</h2>

      <label for="nom">Nom et prénom</label>
      <input id="nom" type="text" placeholder="Votre nom">

      <label for="telephone">Téléphone</label>
      <input id="telephone" type="tel" placeholder="Votre numéro">

      <label for="mode">Mode de réception</label>
      <select id="mode">
        <option value="Livraison">Livraison</option>
        <option value="Retrait sur place">Retrait sur place</option>
      </select>

      <label for="adresse">Adresse ou informations de retrait</label>
      <input id="adresse" type="text" placeholder="Adresse">

      <label for="note">Note facultative</label>
      <textarea id="note" placeholder="Une précision pour la commande"></textarea>

      <button onclick="envoyerCommande()">
        Préparer ma commande
      </button>

      <div id="message" class="message"></div>
    </section>
  </main>

  <script>
    let panier = [];

    function ajouter(nom, prix) {
      panier.push({
        nom: nom,
        prix: prix
      });

      afficherPanier();
    }

    function afficherPanier() {
      const contenu = document.getElementById("contenuPanier");
      const totalElement = document.getElementById("total");

      if (panier.length === 0) {
        contenu.innerHTML = "<p>Votre panier est vide.</p>";
        totalElement.textContent = "0,00 €";
        return;
      }

      let html = "";
      let total = 0;

      panier.forEach(function(plat, index) {
        html += `
          <p>
            ${plat.nom} - ${plat.prix.toFixed(2).replace(".", ",")} €
            <button onclick="supprimer(${index})">
              Supprimer
            </button>
          </p>
        `;

        total += plat.prix;
      });

      contenu.innerHTML = html;
      totalElement.textContent =
        total.toFixed(2).replace(".", ",") + " €";
    }

    function supprimer(index) {
      panier.splice(index, 1);
      afficherPanier();
    }

    function envoyerCommande() {
      const nom = document.getElementById("nom").value;
      const telephone = document.getElementById("telephone").value;
      const mode = document.getElementById("mode").value;
      const adresse = document.getElementById("adresse").value;
      const note = document.getElementById("note").value;
      const message = document.getElementById("message");

      if (panier.length === 0) {
        alert("Ajoutez au moins un plat au panier.");
        return;
      }

      if (nom === "" || telephone === "" || adresse === "") {
        alert("Veuillez remplir votre nom, votre téléphone et votre adresse.");
        return;
      }

      let total = 0;
      let details = "";

      panier.forEach(function(plat) {
        details += "- " + plat.nom + " : " + plat.prix + " €\n";
        total += plat.prix;
      });

      const commande =
        "Bonjour Tasty & Crémeux !\n\n" +
        "Nouvelle commande :\n" +
        details +
        "\nTotal : " + total.toFixed(2) + " €\n" +
        "Nom : " + nom + "\n" +
        "Téléphone : " + telephone + "\n" +
        "Mode : " + mode + "\n" +
        "Adresse : " + adresse + "\n" +
        "Note : " + note;

      message.style.display = "block";
      message.innerHTML =
        "Votre commande est préparée. Vous pouvez copier le récapitulatif ci-dessous :<br><br>" +
        commande.replace(/\n/g, "<br>");

      navigator.clipboard?.writeText(commande);
    }
  </script>
</body>
</html>
